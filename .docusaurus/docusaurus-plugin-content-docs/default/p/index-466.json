-monitoring/customer/"},{"type":"category","label":"Transaction","collapsible":true,"collapsed":true,"items":[{"type":"link","href":"/transaction-monitoring/transaction/process-transaction","label":"Process Transaction","docId":"transaction-monitoring/transaction/process-transaction","unlisted":false},{"type":"link","href":"/transaction-monitoring/transaction/rescore-transaction","label":"Rescore Transaction","docId":"transaction-monitoring/transaction/rescore-transaction","unlisted":false},{"type":"link","href":"/transaction-monitoring/transaction/get-transaction","label":"Get Transaction","docId":"transaction-monitoring/transaction/get-transaction","unlisted":false},{"type":"link","href":"/transaction-monitoring/transaction/transaction-statuses","label":"Transaction Statuses","docId":"transaction-monitoring/transaction/transaction-statuses","unlisted":false}],"href":"/transaction-monitoring/transaction/"}],"href":"/transaction-monitoring/"},{"type":"category","label":"Screening","collapsible":true,"collapsed":true,"items":[{"type":"link","href":"/screening/pep-sanction-screening","label":"PEP & Sanction Screening","docId":"screening/pep-sanction-screening","unlisted":false},{"type":"link","href":"/screening/screening-result","label":"Get Screening Result","docId":"screening/screening-result","unlisted":false},{"type":"link","href":"/screening/adverse-media","label":"Adverse Media","docId":"screening/adverse-media","unlisted":false}],"href":"/screening/"}]},"docs":{"id-verification/Document/document-liveness":{"id":"id-verification/Document/document-liveness","title":"Document Liveness","description":"Passive liveness detection enhances security for person and/or document authentication solutions. It adds detection and alerting capabilities when a printed photo or digital image or a screenshot from monitor/TV is presented for identity authentication or physical access control workflows.","sidebar":"tutorialSidebar"},"id-verification/Document/index":{"id":"id-verification/Document/index","title":"Document","description":"","sidebar":"tutorialSidebar"},"id-verification/face/face-detect":{"id":"id-verification/face/face-detect","title":"Face Detect","description":"Detects face and extracts attributes of it.","sidebar":"tutorialSidebar"},"id-verification/face/face-liveness":{"id":"id-verification/face/face-liveness","title":"Face Liveness","description":"Passive liveness detection enhances security for person and/or document authentication solutions. It adds detection and alerting capabilities when a printed photo or digital image or a screenshot from monitor/TV is presented for identity authentication or physical access control workflows.","sidebar":"tutorialSidebar"},"id-verification/face/face-verification":{"id":"id-verification/face/face-verification","title":"Face Verification","description":"The face verification endpoint is essential for confirming an individual’s presence by matching their live capture against a pre-registered or document-linked photo. This process is integral for verifying identity authenticity, safeguarding against impersonation, and ensuring the person engaging with the service is who they claim to be.","sidebar":"tutorialSidebar"},"id-verification/face/index":{"id":"id-verification/face/index","title":"Face","description":"","sidebar":"tutorialSidebar"},"id-verification/full-onboarding/create-session":{"id":"id-verification/full-onboarding/create-session","title":"Create Session","description":"Create a new enrolment session","sidebar":"tutorialSidebar"},"id-verification/full-onboarding/data":{"id":"id-verification/full-onboarding/data","title":"Data","description":"The output of an API call is provided by our decision engine - an automated evaluation mechanism which helps us reduce the risk of fraud as well as improving customer experience in non-assisted enrollments. There are several logical units of evaluation which need to be considered in terms of decision mechanisms and these units are called Trust Factors.","sidebar":"tutorialSidebar"},"id-verification/full-onboarding/enrolment":{"id":"id-verification/full-onboarding/enrolment","title":"Enrolment","description":"Redirect to Web Enrolment","sidebar":"tutorialSidebar"},"id-verification/full-onboarding/getting-started":{"id":"id-verification/full-onboarding/getting-started","title":"Getting Started","description":"Real life examples of how to use our SDK's.","sidebar":"tutorialSidebar"},"id-verification/full-onboarding/index":{"id":"id-verification/full-onboarding/index","title":"Full Onboarding","description":"","sidebar":"tutorialSidebar"},"id-verification/full-onboarding/results":{"id":"id-verification/full-onboarding/results","title":"Results","description":"The output of an API call is provided by our decision engine - an automated evaluation mechanism which helps us reduce the risk of fraud as well as improve customer experience in non-assisted enrollments. There are several logical units of evaluation which need to be considered in terms of decision mechanisms and these units are called Trust Factors.","sidebar":"tutorialSidebar"},"id-verification/identity/🇳🇬 nigeria/business-verification":{"id":"id-verification/identity/🇳🇬 nigeria/business-verification","title":"Business Verification","description":"Verify Business (CAC)","sidebar":"tutorialSidebar"},"id-verification/identity/🇳🇬 nigeria/bvn":{"id":"id-verification/identity/🇳🇬 nigeria/bvn","title":"BVN Verification","description":"Verify Bank Verification Number (BVN)","sidebar":"tutorialSidebar"},"id-verification/identity/🇳🇬 nigeria/nin":{"id":"id-verification/identity/🇳🇬 nigeria/nin","title":"NIN Verification","description":"Verify National Identification Number (NIN)","sidebar":"tutorialSidebar"},"id-verification/identity/🇳🇬 nigeria/tin":{"id":"id-verification/identity/🇳🇬 nigeria/tin","title":"TIN Verification","description":"Verify Tax Identification Number (TIN)","sidebar":"tutorialSidebar"},"id-verification/identity/🇳🇬 nigeria/vnin":{"id":"id-verification/identity/🇳🇬 nigeria/vnin","title":"vNIN Verification","description":"Verify Virtual National Identification Number (vNIN)","sidebar":"tutorialSidebar"},"id-verification/identity/index":{"id":"id-verification/identity/index","title":"Identity Verification","description":"","sidebar":"tutorialSidebar"},"id-verification/index":{"id":"id-verification/index","title":"Id Verification","description":"","sidebar":"tutorialSidebar"},"intro":{"id":"intro","title":"Introduction","description":"The purpose of this document is to help our customers and partners integrate with Fraudspect Identity API Cloud.","sidebar":"tutorialSidebar"},"screening/adverse-media":{"id":"screening/adverse-media","title":"Adverse Media","description":"Adverse Media Screening","sidebar":"tutorialSidebar"},"screening/index":{"id":"screening/index","title":"Screening","description":"","sidebar":"tutorialSidebar"},"screening/pep-sanction-screening":{"id":"screening/pep-sanction-screening","title":"PEP & Sanction Screening","description":"Search Persons — PEP & Sanctions","sidebar":"tutorialSidebar"},"screening/screening-result":{"id":"screening/screening-result","title":"Get Screening Result","description":"Get Person Result Details","sidebar":"tutorialSidebar"},"transaction-monitoring/customer/create-update-customer":{"id":"transaction-monitoring/customer/create-update-customer","title":"Create/Update Customer","description":"Create or update a customer record. If a customer with the same referenceId already exists for your organisation, this endpoint performs an update instead of creating a duplicate.","sidebar":"tutorialSidebar"},"transaction-monitoring/customer/customer-connections":{"id":"transaction-monitoring/customer/customer-connections","title":"Customer Connections","description":"Link customers to related entities — directors, UBOs, shareholders, and more. Connections are synced to Finchecker and used in relationship mapping during screening and transaction monitoring.","sidebar":"tutorialSidebar"},"transaction-monitoring/customer/get-customer":{"id":"transaction-monitoring/customer/get-customer","title":"Get Customer","description":"Retrieve a customer record by their referenceId.","sidebar":"tutorialSidebar"},"transaction-monitoring/customer/index":{"id":"transaction-monitoring/customer/index","title":"Customer","description":"Transaction monitoring for customers.","sidebar":"tutorialSidebar"},"transaction-monitoring/index":{"id":"transaction-monitoring/index","title":"Transaction Monitoring","description":"","sidebar":"tutorialSidebar"},"transaction-monitoring/transaction/get-transaction":{"id":"transaction-monitoring/transaction/get-transaction","title":"Get Transaction","description":"Get Customer by referenceId","sidebar":"tutorialSidebar"},"transaction-monitoring/transaction/index":{"id":"transaction-monitoring/transaction/index","title":"Transaction","description":"","sidebar":"tutorialSidebar"},"transaction-monitoring/transaction/process-transaction":{"id":"transaction-monitoring/transaction/process-transaction","title":"Process Transaction","description":"Submit a transaction for fraud scoring. Rules configured for the selected service are evaluated and a risk score is returned.","sidebar":"tutorialSidebar"},"transaction-monitoring/transaction/rescore-transaction":{"id":"transaction-monitoring/transaction/rescore-transaction","title":"Rescore Transaction","description":"Reprocess an existing transaction through the fraud scoring rules. Useful when rules have changed or when manual review is complete and a fresh score is needed.","sidebar":"tutorialSidebar"},"transaction-monitoring/transaction/transaction-statuses":{"id":"transaction-monitoring/transaction/transaction-statuses","title":"Transaction Statuses","description":"List of possible transaction statuses and their corresponding ID / ENUMs.","sidebar":"tutorialSidebar"}}}}